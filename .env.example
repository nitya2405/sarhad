# Copy to .env (git-ignored). Only VITE_* values reach the browser.
# Leave both VITE_* empty (or run `npm run dev:offline`) for a build with no server and the bundled schedule.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never prefix these with VITE_. SUPABASE_DB_PASSWORD is read by `supabase db push` if set.
SUPABASE_PROJECT_REF=yqxvvxfodtlvdbzdwvhd
SUPABASE_DB_PASSWORD=
