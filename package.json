{
  "name": "sarhad",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:map": "tsx scripts/build-map.ts",
    "data:check": "tsx scripts/check-adjacency.ts",
    "data:validate": "tsx scripts/validate-graph.ts",
    "data:puzzles": "tsx scripts/gen-puzzles.ts",
    "data:sync": "tsx scripts/check-sync.ts",
    "data:build": "npm run data:map && npm run data:check && npm run data:validate && npm run data:puzzles && npm run data:sync",
    "db:schedule": "tsx supabase/scripts/gen-schedule-migration.ts",
    "dev:offline": "vite --mode offline --host",
    "build:offline": "tsc -b && vite build --mode offline",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "jsdom": "^29.1.1",
    "mapshaper": "^0.7.87",
    "polylabel": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
