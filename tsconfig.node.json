{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@engine/*": [
        "./supabase/functions/_shared/engine/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "scripts",
    "playwright.config.ts",
    "e2e"
  ]
}
